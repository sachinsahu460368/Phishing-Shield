
# PhishShield AI — Environment Configuration
# Copy this file to .env and adjust as needed.

# Demo mode: uses mock data instead of calling the backend API.
# Set to "false" only when a real backend is available.
VITE_DEMO_MODE=false

# Backend API base URL (used only when VITE_DEMO_MODE=false)
VITE_API_BASE_URL=http://localhost:8000
